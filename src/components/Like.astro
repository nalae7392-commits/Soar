---
interface Props {
	path: string;
}

const { path } = Astro.props;
---

<button class="like" type="button" data-path={path} aria-label="Like this post">
	<svg class="like-heart" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
		<path
			d="M12 21s-7.5-4.6-10-9.1C0.4 8.6 2 5 5.5 5c2 0 3.4 1.1 4.5 2.6C11.1 6.1 12.5 5 14.5 5 18 5 19.6 8.6 22 11.9 19.5 16.4 12 21 12 21z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
	</svg>
	<span class="like-count"></span>
</button>

<style>
	.like {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		margin: 0;
		padding: 0;
		border: none;
		background: none;
		color: var(--color-secondary);
		font-family: var(--font-mono);
		font-size: 1em;
		line-height: 1;
		cursor: pointer;
	}
	.like-heart {
		flex-shrink: 0;
	}
	.like.liked {
		color: var(--color-text);
	}
	.like.liked .like-heart path {
		fill: currentColor;
	}
	.like:disabled {
		cursor: default;
		opacity: 0.6;
	}
</style>

<script>
	import { getArticleCounter, updateArticleCounter } from 'https://unpkg.com/@waline/api@1/dist/index.js';

	const SERVER_URL = 'https://soar-comments-2.vercel.app';
	const LANG = 'en';
	const TYPE = 'reaction0';
	const STORAGE_PREFIX = 'waline-like:';

	document.querySelectorAll<HTMLButtonElement>('.like[data-path]').forEach(async (button) => {
		const path = button.dataset.path as string;
		const countEl = button.querySelector<HTMLSpanElement>('.like-count')!;

		if (localStorage.getItem(STORAGE_PREFIX + path) === '1') {
			button.classList.add('liked');
		}

		try {
			const [data] = await getArticleCounter({
				serverURL: SERVER_URL,
				lang: LANG,
				paths: [path],
				type: [TYPE],
			});

			countEl.textContent = String((data as Record<string, number>)[TYPE] ?? 0);
		} catch {
			countEl.textContent = '0';
		}

		button.addEventListener('click', async () => {
			if (button.disabled) return;
			button.disabled = true;

			const isLiked = button.classList.contains('liked');
			const current = Number(countEl.textContent) || 0;

			try {
				await updateArticleCounter({
					serverURL: SERVER_URL,
					lang: LANG,
					path,
					type: TYPE,
					action: isLiked ? 'desc' : 'inc',
				});

				countEl.textContent = String(Math.max(0, current + (isLiked ? -1 : 1)));
				button.classList.toggle('liked', !isLiked);

				if (isLiked) {
					localStorage.removeItem(STORAGE_PREFIX + path);
				} else {
					localStorage.setItem(STORAGE_PREFIX + path, '1');
				}
			} finally {
				button.disabled = false;
			}
		});
	});
</script>
