---
interface Props {
	images: string[];
	alts?: string[];
}

const { images, alts = [] } = Astro.props;
---

<div class="carousel">
	<div class="carousel-viewport">
		<div class="carousel-track">
			{
				images.map((src, i) => (
					<img class="carousel-image" src={src} alt={alts[i] ?? ''} loading="lazy" />
				))
			}
		</div>
		<button type="button" class="carousel-arrow carousel-arrow-prev" aria-label="Previous image">
			‹
		</button>
		<button type="button" class="carousel-arrow carousel-arrow-next" aria-label="Next image">
			›
		</button>
	</div>
	<div class="carousel-dots">
		{
			images.map((_, i) => (
				<button
					type="button"
					class="carousel-dot"
					aria-label={`Go to image ${i + 1}`}
					data-index={i}
				/>
			))
		}
	</div>
</div>

<style>
	.carousel {
		margin: 3em 0;
	}
	.carousel-viewport {
		position: relative;
		width: 100%;
		max-width: 700px;
		margin: 0 auto;
		aspect-ratio: 4 / 5;
		overflow: hidden;
	}
	.carousel-track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.3s ease;
	}
	.carousel-image {
		flex-grow: 0;
		flex-shrink: 0;
		flex-basis: 100%;
		width: 100%;
		min-width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
	}
	.carousel-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2em;
		height: 2em;
		margin: 0;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.7);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 1.25em;
		line-height: 1;
		cursor: pointer;
	}
	.carousel-arrow:hover {
		background: rgba(255, 255, 255, 0.9);
	}
	.carousel-arrow-prev {
		left: 0.5em;
	}
	.carousel-arrow-next {
		right: 0.5em;
	}
	.carousel-dots {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6em;
		margin-top: 1em;
	}
	.carousel-dot {
		width: 0.5em;
		height: 0.5em;
		margin: 0;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: #d9d9d9;
		cursor: pointer;
	}
	.carousel-dot.active {
		background: var(--color-text);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('.carousel-track');
		const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
		const prevButton = carousel.querySelector<HTMLButtonElement>('.carousel-arrow-prev');
		const nextButton = carousel.querySelector<HTMLButtonElement>('.carousel-arrow-next');
		if (!track || !prevButton || !nextButton || dots.length === 0) return;

		const count = dots.length;
		let index = 0;

		function update() {
			track!.style.transform = `translateX(-${index * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
		}

		function goTo(newIndex: number) {
			index = (newIndex + count) % count;
			update();
		}

		prevButton.addEventListener('click', () => goTo(index - 1));
		nextButton.addEventListener('click', () => goTo(index + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		update();
	});
</script>
